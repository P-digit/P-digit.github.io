{
  "name": "post-meta",
  "version": "1.0.0",
  "private": true,
  "description": "content-meta 대체: 한국어 날짜와 '약 N분' 읽는 시간 — 빌드 단계 없이 dist/에 직접 작성한 플레인 ESM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "post-meta",
    "displayName": "날짜 · 읽는 시간",
    "category": "component",
    "quartzVersion": ">=5.2.0",
    "components": {
      "PostMeta": {
        "displayName": "날짜 · 읽는 시간",
        "description": "content-meta 대체: 한국어 날짜와 '약 N분' 읽는 시간",
        "defaultPosition": "beforeBody",
        "defaultPriority": 20
      }
    }
  }
}
