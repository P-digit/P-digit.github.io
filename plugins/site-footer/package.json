{
  "name": "site-footer",
  "version": "1.0.0",
  "private": true,
  "description": "footer 대체: 한국어 저작권 줄과 링크 — 빌드 단계 없이 dist/에 직접 작성한 플레인 ESM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "site-footer",
    "displayName": "푸터",
    "category": "component",
    "quartzVersion": ">=5.2.0",
    "components": {
      "SiteFooter": {
        "displayName": "푸터",
        "description": "footer 대체: 한국어 저작권 줄과 링크",
        "defaultPosition": "footer",
        "defaultPriority": 50
      }
    }
  }
}
